{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vendremonplex.com/schemas/evaluation-bloc-donnees-2.0.json",
  "$comment": "VERSION 2 — BROUILLON À APPROUVER PAR P-O (décision du 2026-11-19 : conserver nom, téléphone, courriel, adresse exacte, prix payé et toutes les entrées). Contient des RENSEIGNEMENTS PERSONNELS : aucun envoi sans consentement explicite (case non précochée), version du texte et finalités. L'$id est logique, pas une URL publiée. La v1 (schema_donnees.json) est conservée.",
  "title": "Évaluation de bloc : données envoyées au backend, v2 (avec renseignements personnels sous consentement)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "horodatage",
    "pageOrigine",
    "parametresVersion",
    "consentement",
    "identite",
    "immeuble",
    "entrees",
    "resultat",
    "hp"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "horodatage": {
      "type": "string",
      "format": "date-time"
    },
    "pageOrigine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "parametresVersion": {
      "type": "string",
      "description": "Version des paramètres (actuelle : 0.1.0-brouillon-2026-11-19)."
    },
    "consentement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepte",
        "methode",
        "version",
        "horodatage",
        "finalites"
      ],
      "properties": {
        "accepte": {
          "const": true,
          "description": "Aucun envoi sans consentement explicite."
        },
        "methode": {
          "const": "case_a_cocher_non_precochee",
          "description": "Le consentement provient d'une case cochée par la personne, jamais précochée."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Version du texte de consentement approuvé par P-O (inconnue à ce jour)."
        },
        "horodatage": {
          "type": "string",
          "format": "date-time",
          "description": "Moment où la case a été cochée."
        },
        "finalites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "contact_evaluation",
              "statistiques_marche"
            ]
          },
          "description": "contact_evaluation = Vous contacter au sujet de votre évaluation; statistiques_marche = Produire des statistiques de marché"
        }
      }
    },
    "identite": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prenom",
            "nom",
            "telephone",
            "courriel"
          ],
          "properties": {
            "prenom": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "nom": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "telephone": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 25,
                  "pattern": "^(\\+?1[\\s.-]?)?\\(?[2-9]\\d{2}\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "courriel": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$",
                  "format": "email"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "not": {
            "properties": {
              "telephone": {
                "type": "null"
              },
              "courriel": {
                "type": "null"
              }
            }
          },
          "description": "Téléphone ou courriel : au moins un des deux."
        }
      ],
      "description": "Renseignements personnels. Présents SEULEMENT si la finalité « contact_evaluation » est consentie."
    },
    "immeuble": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adresse",
        "municipalite",
        "codePostal",
        "ville",
        "nombreLogements",
        "prixAchat",
        "anneeAchat",
        "prixPayeParPorte"
      ],
      "properties": {
        "adresse": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "municipalite": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "codePostal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[ABCEGHJ-NPRSTVXY]\\d[ABCEGHJ-NPRSTV-Z] ?\\d[ABCEGHJ-NPRSTV-Z]\\d$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ville": {
          "enum": [
            "sherbrooke",
            "magog",
            "montreal",
            "quebec",
            "gatineau",
            "troisrivieres",
            "saguenay"
          ],
          "description": "Ville de référence (RMR) utilisée pour les loyers SCHL et les barèmes."
        },
        "nombreLogements": {
          "type": "number",
          "minimum": 0
        },
        "prixAchat": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "anneeAchat": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1900,
              "maximum": 2100
            },
            {
              "type": "null"
            }
          ]
        },
        "prixPayeParPorte": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "description": "Déduit : prix d'achat / nombre de logements."
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
